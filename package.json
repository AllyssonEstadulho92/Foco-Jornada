{
  "name": "foco-jornada",
  "private": true,
  "version": "1.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "worker:check": "wrangler deploy --dry-run --outdir .wrangler-check"
  },
  "dependencies": {
    "dexie": "4.2.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-hot-toast": "2.6.0",
    "react-router-dom": "7.18.3",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.0",
    "fake-indexeddb": "6.2.2",
    "globals": "16.3.0",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0",
    "vite": "7.3.6",
    "vite-plugin-pwa": "1.0.3",
    "vitest": "5.0.0",
    "wrangler": "4.129.0"
  },
  "overrides": {
    "sharp": "0.35.4"
  },
  "engines": {
    "node": ">=22 <25"
  }
}
